# =============================================================================
# Nockta Flow — production environment template
#
# Copy these variables into Railway → Project → Variables for the `api` service.
# Web + client frontends only need VITE_API_URL at build time (passed as a
# Docker build-arg in railway.json's deploy step or via Railway's UI).
#
# Anything marked REQUIRED will hard-fail boot in production via the guard in
# apps/api/src/bootstrap-env.ts. Optional values are silently disabled and
# logged at boot as "disabled" in the integration banner.
# =============================================================================

# ---- Core ----
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# ---- Database (REQUIRED) ----
# Railway Postgres plugin variable. The companion.sql migration runs on every
# boot via apps/api/scripts/start.sh — partitioning, FTS columns, MVs.
DATABASE_URL=${{Postgres.DATABASE_URL}}
# Optional: a direct (non-pooler) URL used by Prisma migrate. Skip unless you
# put PgBouncer in front of DATABASE_URL.
# DATABASE_DIRECT_URL=

# ---- Redis (REQUIRED) ----
# Sessions, BullMQ, Socket.IO adapter, scheduler leader-election.
REDIS_URL=${{Redis.REDIS_URL}}

# ---- Object storage (REQUIRED) ----
# Cloudflare R2 recommended. For R2: S3_REGION=auto, no path-style.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=nockta-flow-prod
S3_QUARANTINE_BUCKET=nockta-flow-quarantine
S3_FORCE_PATH_STYLE=false

# ---- Vector DB + LLM ----
QDRANT_URL=http://qdrant.railway.internal:6333
QDRANT_API_KEY=

LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Ollama is only used when LLM_PROVIDER=ollama. The URL is still required by
# the env schema (zod .url()); set to any valid URL even if unused.
OLLAMA_URL=http://ollama.railway.internal:11434
OLLAMA_MODEL=llama3.2

# ---- Virus scanning ----
CLAMAV_HOST=clamav.railway.internal
CLAMAV_PORT=3310

# ---- Auth — JWT (REQUIRED, ≥32 chars, must differ from each other) ----
# Generate with:  pnpm gen:secrets    (or:  openssl rand -base64 32)
# Boot will fail if either matches the placeholder in .env.example, or if
# the two values are equal (reuse detection relies on them differing).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# ---- Auth — Google OAuth (REQUIRED for internal sign-in) ----
# 1. https://console.cloud.google.com/apis/credentials → Create credentials →
#    OAuth client ID → Web application.
# 2. Authorized redirect URI MUST match GOOGLE_OAUTH_REDIRECT_URI exactly,
#    INCLUDING the trailing /api/v1/auth/google/callback path. A common
#    foot-gun is registering /auth/google/callback (no /api/v1/ prefix);
#    Google will redirect successfully but token exchange fails.
# 3. ALLOWED_DOMAIN filters which Workspace tenant can sign in. Anyone with
#    a non-matching domain gets a 401 from the strategy's validate() hook.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.nockta.com/api/v1/auth/google/callback
GOOGLE_OAUTH_ALLOWED_DOMAIN=nockta.com

# ---- Auth — magic links (client portal) ----
# Gmail SMTP via Google Workspace, impersonating noreply@nockta.com.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@nockta.com
SMTP_PASSWORD=
SMTP_FROM="Nockta Flow <noreply@nockta.com>"
SMTP_USE_TLS=true
MAGIC_LINK_TTL_SECONDS=900
MAGIC_LINK_BASE_URL=https://app.nockta.com/auth/magic

# ---- GitHub App (optional — needed for PR auto-status + summarization) ----
# Create at https://github.com/settings/apps. Webhook URL goes to api.nockta.com.
# Setup URL (post-install redirect): https://api.nockta.com/api/v1/github/install/callback
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_INSTALLATION_ID=

# ---- Google Chat bot (optional — Chat DMs + space broadcasts) ----
# Service-account JSON, single-line escaped.
GOOGLE_CHAT_SERVICE_ACCOUNT_JSON=
GOOGLE_CHAT_PROJECT_ID=
GOOGLE_CHAT_APP_ID=
GOOGLE_CHAT_INTERACTION_TOKEN_AUDIENCE=

# ---- Deployment webhook secrets (optional) ----
# One HMAC secret per supported source. Used to verify incoming deploy events.
DEPLOY_WEBHOOK_SECRET_VERCEL=
DEPLOY_WEBHOOK_SECRET_RAILWAY=
DEPLOY_WEBHOOK_SECRET_GITHUB_ACTIONS=
DEPLOY_WEBHOOK_SECRET_GENERIC=

# ---- Public URLs (REQUIRED) ----
APP_URL_INTERNAL=https://app.nockta.com
APP_URL_CLIENT=https://app.nockta.com
APP_URL_API=https://api.nockta.com

# ---- CORS ----
# CSV. The API is bearer-token only (credentials: false), so this is mostly
# an XHR origin allowlist.
CORS_ORIGINS=https://app.nockta.com

# ---- Rate limiting ----
RATE_LIMIT_GLOBAL_PER_MIN=600
RATE_LIMIT_PER_USER_PER_MIN=120

# ---- Observability ----
PROMETHEUS_METRICS_ENABLED=true
# Optional Sentry. Leave empty to disable (no crash on missing).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---- Search backend (optional) ----
# Leave empty to use the built-in Postgres FTS path. Setting the URL switches
# SearchService to Elasticsearch/OpenSearch as the primary index.
SEARCH_ELASTIC_URL=
SEARCH_ELASTIC_INDEX_TASKS=nockta_tasks
SEARCH_ELASTIC_API_KEY=
