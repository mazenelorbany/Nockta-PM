{
  "title": "Nockta Flow — Maintenance & Scheduler",
  "uid": "nockta-maintenance",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "tags": ["nockta", "ops"],
  "time": { "from": "now-24h", "to": "now" },
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Attachment purge — outcomes per hour",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (outcome) (increase(nockta_attachment_purge_total[1h]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Storage-failed purges (last 1h)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "If this rises while purged stalls, S3 is unhappy — rows pile up in soft-deleted state.",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "increase(nockta_attachment_purge_total{outcome=\"storage_failed\"}[1h])",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 25 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Scheduler-lock acquisitions (per lock key)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (lock_key, outcome) (rate(nockta_scheduler_lock_acquisitions_total[5m]))",
          "legendFormat": "{{lock_key}} · {{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Lock contention rate (busy / total, 15m)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Healthy: < 0.5 (most replicas attempt but one gets it). > 0.95 means one replica is monopolizing the lock — investigate whether a single replica is somehow ticking faster.",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(nockta_scheduler_lock_acquisitions_total{outcome=\"busy\"}[15m])) / sum(rate(nockta_scheduler_lock_acquisitions_total[15m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 0.7 },
              { "color": "red", "value": 0.95 }
            ]
          }
        }
      }
    }
  ]
}
