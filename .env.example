#=============================================================================
# Nockta Flow — environment variables
# Copy to .env and fill in real values. Never commit .env.
#
# SECRETS QUICKSTART
# ------------------
# Don't ship the placeholder JWT secrets below — the API will refuse to boot
# in production if it sees them. Generate fresh values:
#
#     pnpm gen:secrets               # prints two random base64url secrets
#     pnpm gen:secrets >> apps/api/.env    # appends them to your env file
#     pnpm gen:secrets --all         # also generates webhook HMAC secrets
#
# Then edit your .env and delete the original placeholder lines.
#
# GOOGLE OAUTH
# ------------
# Create an OAuth 2.0 Web client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI MUST match GOOGLE_OAUTH_REDIRECT_URI below EXACTLY,
# including the /api/v1/ prefix (main.ts uses setGlobalPrefix):
#   dev:  http://localhost:3000/api/v1/auth/google/callback
#   prod: ${APP_URL_API}/api/v1/auth/google/callback
# A common foot-gun is registering /auth/google/callback (no prefix); Google
# will redirect successfully but the API returns 404.
#=============================================================================

# --- Node ---
NODE_ENV=development
LOG_LEVEL=debug

# Dev auth gate — when 'true' AND NODE_ENV is not 'production', the
# /auth/dev/* endpoints (persona login, login-by-email, login-as) are active.
# These mint Admin tokens with no credential check, so leave it 'false' unless
# you actually need them. Production refuses to enable dev-auth regardless.
DEV_AUTH_ENABLED=true

# --- Database (Postgres) ---
DATABASE_URL=postgresql://nockta:nockta_dev_pw@localhost:5432/nockta_flow?schema=public
DATABASE_DIRECT_URL=postgresql://nockta:nockta_dev_pw@localhost:5432/nockta_flow?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Object storage (S3-compatible — MinIO local, R2 in prod) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=nockta_minio
S3_SECRET_KEY=nockta_minio_dev_pw
S3_BUCKET=nockta-flow-dev
S3_QUARANTINE_BUCKET=nockta-flow-quarantine
S3_FORCE_PATH_STYLE=true

# --- ClamAV ---
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# --- Qdrant (vector DB for AI layer) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- LLM (Ollama local, Anthropic for prod swap) ---
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Duplicate-detection threshold for the AI module. Range 0..1; 0.85 is the
# default. Raise toward 0.95 to flag fewer dupes (higher precision); lower
# toward 0.75 to flag more (higher recall).
AI_DUP_THRESHOLD=0.85

# --- Auth ---
JWT_ACCESS_SECRET=change-me-to-a-real-secret-at-least-32-chars-long
JWT_REFRESH_SECRET=change-me-to-a-different-real-secret-at-least-32-chars-long
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# --- Google OAuth (internal user login) ---
# REDIRECT_URI MUST include the /api/v1/ prefix — main.ts uses setGlobalPrefix
# so the callback lives at /api/v1/auth/google/callback, not /auth/google/callback.
# Register the SAME URL as an Authorized redirect URI in Google Cloud Console.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
GOOGLE_OAUTH_ALLOWED_DOMAIN=nockta.com

# --- Magic-link email (Gmail SMTP via Google Workspace; mailhog in dev) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Nockta Flow <noreply@nockta.com>
SMTP_USE_TLS=false

# In production:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USE_TLS=true
# SMTP_USER=noreply@nockta.com
# SMTP_PASSWORD=<app-password-or-OAuth-token>

# --- Magic links ---
MAGIC_LINK_TTL_SECONDS=900
MAGIC_LINK_BASE_URL=http://localhost:5173/auth/magic

# --- GitHub App ---
GITHUB_APP_ID=
# Public app slug — the segment after github.com/apps/. SettingsPage uses
# it to build the install deeplink github.com/apps/<slug>/installations/new.
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_INSTALLATION_ID=

# --- Google Chat App ---
GOOGLE_CHAT_SERVICE_ACCOUNT_JSON=
GOOGLE_CHAT_PROJECT_ID=
GOOGLE_CHAT_APP_ID=
GOOGLE_CHAT_INTERACTION_TOKEN_AUDIENCE=

# --- Deployment webhook receivers (HMAC secrets per provider) ---
DEPLOY_WEBHOOK_SECRET_VERCEL=
DEPLOY_WEBHOOK_SECRET_RAILWAY=
DEPLOY_WEBHOOK_SECRET_GITHUB_ACTIONS=
DEPLOY_WEBHOOK_SECRET_GENERIC=

# --- App URLs (used in emails, Chat cards, OAuth redirects) ---
APP_URL_INTERNAL=http://localhost:5173
APP_URL_CLIENT=http://localhost:5173
APP_URL_API=http://localhost:3000

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- Rate limiting ---
RATE_LIMIT_GLOBAL_PER_MIN=600
RATE_LIMIT_PER_USER_PER_MIN=120

# --- Observability ---
OTEL_SERVICE_NAME=nockta-api
PROMETHEUS_METRICS_ENABLED=true
LOKI_URL=http://localhost:3100
