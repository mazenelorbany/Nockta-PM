{
  "name": "@nockta/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "_comment_dev": "rimraf nukes any stale dist (incl. ones built with the old tsconfig that placed main.js at dist/apps/api/src/main.js). nest build then produces dist/main.js. nest start --watch keeps it updated; deleteOutDir:false in nest-cli.json preserves the pre-built dist so node can find main.js immediately.",
    "dev": "rimraf dist && nest build && nest start --watch",
    "start": "node dist/main.js",
    "start:debug": "rimraf dist && nest build && nest start --debug --watch",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "import:jira": "tsx scripts/import-from-jira.ts",
    "import:jira:dry": "IMPORT_DRY_RUN=1 tsx scripts/import-from-jira.ts",
    "import:linear": "tsx scripts/import-from-linear.ts",
    "import:linear:dry": "IMPORT_DRY_RUN=1 tsx scripts/import-from-linear.ts",
    "wipe:local": "tsx scripts/wipe-local-data.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.31.0",
    "@aws-sdk/client-s3": "^3.658.0",
    "@aws-sdk/s3-request-presigner": "^3.658.0",
    "@nestjs/bullmq": "^10.2.0",
    "@nestjs/schedule": "^4.1.0",
    "@qdrant/js-client-rest": "^1.11.0",
    "google-auth-library": "^9.14.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.0",
    "@nestjs/event-emitter": "^2.0.4",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/platform-socket.io": "^10.4.0",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/terminus": "^10.2.3",
    "@nestjs/throttler": "^6.2.0",
    "@nestjs/websockets": "^10.4.0",
    "@nockta/types": "workspace:*",
    "@octokit/auth-app": "^7.1.1",
    "@octokit/rest": "^21.0.2",
    "@octokit/webhooks": "^13.3.0",
    "@prisma/client": "^5.20.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^5.13.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "fractional-indexing": "^3.2.0",
    "googleapis": "^144.0.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "nanoid": "^5.0.7",
    "nestjs-pino": "^4.1.0",
    "nodemailer": "^6.9.15",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^11.2.2",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.33.5",
    "socket.io": "^4.7.5",
    "ulid": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.0",
    "@nockta/eslint-config": "workspace:*",
    "@nockta/tsconfig": "workspace:*",
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.0",
    "@types/nodemailer": "^6.4.16",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/passport-jwt": "^4.0.1",
    "prisma": "^5.20.0",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
