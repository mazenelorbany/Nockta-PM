{
  "name": "@nockta/api",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "_comment_dev": "rimraf nukes any stale dist (incl. ones built with the old tsconfig that placed main.js at dist/apps/api/src/main.js). nest build then produces dist/main.js. nest start --watch keeps it updated; deleteOutDir:false in nest-cli.json preserves the pre-built dist so node can find main.js immediately.",
    "dev": "rimraf dist && nest build && nest start --watch",
    "start": "node dist/main.js",
    "start:debug": "rimraf dist && nest build && nest start --debug --watch",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "import:jira": "tsx scripts/import-from-jira.ts",
    "import:jira:dry": "IMPORT_DRY_RUN=1 tsx scripts/import-from-jira.ts",
    "import:linear": "tsx scripts/import-from-linear.ts",
    "import:linear:dry": "IMPORT_DRY_RUN=1 tsx scripts/import-from-linear.ts",
    "wipe:local": "tsx scripts/wipe-local-data.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.97.0",
    "@aws-sdk/client-s3": "^3.1049.0",
    "@aws-sdk/s3-request-presigner": "^3.1049.0",
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.22",
    "@nestjs/event-emitter": "^2.1.1",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/terminus": "^10.3.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^10.4.22",
    "@nockta/types": "workspace:*",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/rest": "^22.0.1",
    "@octokit/webhooks": "^14.2.0",
    "@prisma/client": "^5.22.0",
    "@qdrant/js-client-rest": "^1.18.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^5.76.10",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fractional-indexing": "^3.2.0",
    "google-auth-library": "^10.6.2",
    "googleapis": "^171.4.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "nanoid": "^5.1.11",
    "nestjs-pino": "^4.6.1",
    "nodemailer": "^8.0.7",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "ulid": "^3.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.22",
    "@nockta/eslint-config": "workspace:*",
    "@nockta/tsconfig": "workspace:*",
    "@types/express": "^4.17.25",
    "@types/node": "^25.9.0",
    "@types/nodemailer": "^8.0.0",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "prisma": "^5.22.0",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  }
}
